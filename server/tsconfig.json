{
  // The backup server, the scripts and the tests: everything Node runs as it is, by dropping the
  // types. The app (Next.js) is checked by the tsconfig.json at the top of the repo; keep this
  // file inside server/ so Next does not pick it up.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    // Only syntax Node can run by itself, by dropping the types: no enums, no namespaces with code.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "..",
    "outDir": "dist",
    "noEmit": true
  },
  "include": ["./*.ts", "./aws/*.ts", "../shared/*.ts", "../lib/*.ts", "../tests/*.mts", "../scripts/*.mts"]
}
