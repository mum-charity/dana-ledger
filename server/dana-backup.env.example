# Settings for the 善款簿 backup server. server/pi-setup.sh installs this as /etc/dana-backup.env
# (root only), with a new key in BACKUP_TOKEN. The key is only for reading backups back
# (GET /backups); phones never need it, because uploading needs no key.
BACKUP_TOKEN=
# Sites the app runs on, comma-separated.
ALLOWED_ORIGINS=https://mum.franklee.asia
# Only the Cloudflare Tunnel on the same Pi talks to the server.
HOST=127.0.0.1
PORT=8787
